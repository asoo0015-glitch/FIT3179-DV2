{
  "title": {
    "text": "Newspaper titles added to Trove's list each year, by state"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/titles_added_to_trove.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "titles",
        "op": "sum",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 200
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f6f1e7",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "titles",
          "type": "quantitative",
          "title": "Titles added",
          "scale": {
            "scheme": "oranges",
            "domainMin": 0
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "titles",
            "title": "Titles added"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "titles",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.titles > 45",
            "value": "white"
          },
          "value": "#2b2620"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4, Georgia, serif",
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 16,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Source Serif 4, Georgia, serif",
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 12.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e2dac6",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Source Serif 4, Georgia, serif"
    }
  }
}