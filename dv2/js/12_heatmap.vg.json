{
  "title": {
    "text": [
      "Newspaper titles added to Trove's",
      "list each year, by state"
    ],
    "subtitle": [
      "2013 was the peak: 322 titles added,",
      "183 of them from New South Wales"
    ]
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/titles_added_to_trove.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": "State",
      "sort": {
        "field": "titles",
        "op": "sum",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 260
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fbf7ee",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "titles",
          "type": "quantitative",
          "title": "Titles added",
          "scale": {
            "range": [
              "#e3f1ee",
              "#7fbdb4",
              "#21736d",
              "#0e3f3b"
            ],
            "domainMin": 0
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "titles",
            "title": "Titles added"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "titles",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.titles > 45",
            "value": "white"
          },
          "value": "#2b2620"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}