{
  "title": {
    "text": "How the states ranked",
    "subtitle": [
      "Ranked by newspapers in print.",
      "1st = highest rank (the most)."
    ]
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/bump_active_titles.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "grid": false
      },
      "scale": {
        "padding": 0.5
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {
        "domain": [
          0.6,
          6.4
        ],
        "reverse": true
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "format": "d",
        "grid": false
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "range": [
          "#0072B2",
          "#D55E00",
          "#6b4fa0",
          "#CC79A7",
          "#E69F00",
          "#56B4E9",
          "#8a8478",
          "#5b574e"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hl",
          "select": {
            "type": "point",
            "fields": [
              "state"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 4,
        "interpolate": "monotone"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hl",
            "value": 1
          },
          "value": 0.22
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 1,
        "stroke": "#fbf7ee",
        "strokeWidth": 1.5
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hl",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "titles",
            "title": "Titles in print"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 1950"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "state"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "South Australia",
              "Western Australia",
              "Tasmania",
              "Northern Territory",
              "Australian Capital Territory"
            ],
            "range": [
              "#0072B2",
              "#D55E00",
              "#6b4fa0",
              "#CC79A7",
              "#E69F00",
              "#56B4E9",
              "#8a8478",
              "#5b574e"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}