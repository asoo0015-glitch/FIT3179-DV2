{
  "title": {
    "text": "Where titles clustered (2\u00b0 \u00d7 2\u00b0 squares)"
  },
  "width": "container",
  "height": 330,
  "params": [
    {
      "name": "yr0",
      "value": 1850
    },
    {
      "name": "yr1",
      "value": 1900
    },
    {
      "name": "show_slices",
      "value": true
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "'No data: ' + datum.properties.STE_NAME21",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4dcc8",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": {
          "field": "note"
        }
      }
    },
    {
      "data": {
        "url": "data/titles.csv"
      },
      "transform": [
        {
          "filter": "datum.cell_id != null && datum.start <= yr1 && datum.end >= yr0 && (show_slices || datum.wwi_slice == 0)"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "cell_id"
          ]
        },
        {
          "lookup": "cell_id",
          "from": {
            "data": {
              "url": "data/cells.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.cell_id"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f6f1e7",
        "strokeWidth": 0.6,
        "opacity": 0.92
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "n",
          "type": "quantitative",
          "title": "Titles in square",
          "scale": {
            "type": "threshold",
            "domain": [
              3,
              6,
              11,
              26,
              51
            ],
            "range": [
              "#e3f1ee",
              "#b3dad3",
              "#7fbdb4",
              "#3f968c",
              "#21736d",
              "#0e3f3b"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "values": [
              1,
              3,
              6,
              11,
              26,
              51
            ],
            "labelExpr": "datum.value == 1 ? '1\u20132' : datum.value == 3 ? '3\u20135' : datum.value == 6 ? '6\u201310' : datum.value == 11 ? '11\u201325' : datum.value == 26 ? '26\u201350' : '51+'"
          }
        },
        "tooltip": [
          {
            "field": "n",
            "title": "Titles in this square"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8f866f",
        "strokeWidth": 0.6
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4, Georgia, serif",
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 16,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Source Serif 4, Georgia, serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 12.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e2dac6",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Source Serif 4, Georgia, serif"
    }
  }
}