{
  "title": {
    "text": "Where titles clustered"
  },
  "width": "container",
  "height": 330,
  "params": [
    {
      "name": "yr0",
      "value": 1850
    },
    {
      "name": "yr1",
      "value": 1900
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "'' + datum.properties.STE_NAME21",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4dcc8",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "title": "State"
        }
      }
    },
    {
      "data": {
        "url": "data/titles.csv"
      },
      "transform": [
        {
          "filter": "datum.cell_id != null && datum.cell_id !== '' && datum.start <= yr1 && datum.end >= yr0"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "cell_id"
          ]
        },
        {
          "lookup": "cell_id",
          "from": {
            "data": {
              "url": "data/cells.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.cell_id"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.n >= 51 ? '51+' : datum.n >= 26 ? '26–50' : datum.n >= 11 ? '11–25' : datum.n >= 6 ? '6–10' : datum.n >= 3 ? '3–5' : '1–2'",
          "as": "band"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fbf7ee",
        "strokeWidth": 0.6,
        "opacity": 0.92
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Titles in square",
          "scale": {
            "domain": [
              "51+",
              "26–50",
              "11–25",
              "6–10",
              "3–5",
              "1–2"
            ],
            "range": [
              "#0e3f3b",
              "#21736d",
              "#3f968c",
              "#7fbdb4",
              "#b3dad3",
              "#e3f1ee"
            ]
          },
          "legend": {
            "orient": "left",
            "offset": 4,
            "symbolType": "square",
            "symbolSize": 220,
            "rowPadding": 4
          }
        },
        "tooltip": [
          {
            "field": "n",
            "title": "Titles in this square"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8f866f",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "x": "width",
        "y": 0,
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2b2620"
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}