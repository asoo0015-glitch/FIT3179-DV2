{
  "title": {
    "text": "Titles in print, town by town"
  },
  "width": 620,
  "height": 520,
  "params": [
    {
      "name": "yr0",
      "value": 1850
    },
    {
      "name": "yr1",
      "value": 1900
    },
    {
      "name": "focus",
      "value": [
        134,
        -28.5,
        865
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            134,
            -28.5,
            865
          ],
          [
            148,
            -38.3,
            2800
          ],
          [
            145.3,
            -37.3,
            7790
          ],
          [
            151.0,
            -33.2,
            8370
          ],
          [
            138.6,
            -34.4,
            6300
          ],
          [
            119.5,
            -31.0,
            3970
          ],
          [
            151.5,
            -24.5,
            1650
          ]
        ],
        "labels": [
          "All of Australia",
          "South-east: Victoria, New South Wales, Tasmania",
          "Melbourne and Victoria",
          "Sydney and the Hunter",
          "Adelaide and the Murray",
          "Perth and the goldfields",
          "Queensland coast"
        ],
        "name": "Zoom to: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "center": {
      "expr": "[focus[0] - 132, focus[1]]"
    },
    "scale": {
      "expr": "focus[2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "'' + datum.properties.STE_NAME21",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e4dcc8",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "title": "State"
        }
      }
    },
    {
      "data": {
        "url": "data/titles.csv"
      },
      "transform": [
        {
          "filter": "datum.lat != null && datum.lat !== '' && datum.start <= yr1 && datum.end >= yr0"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            },
            {
              "op": "sum",
              "field": "articles",
              "as": "arts"
            }
          ],
          "groupby": [
            "place",
            "state",
            "lat",
            "lon"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "n",
          "type": "quantitative",
          "title": "Titles in print",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              120
            ],
            "range": [
              0,
              1900
            ]
          },
          "legend": null
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "South Australia",
              "Western Australia",
              "Tasmania",
              "Northern Territory",
              "Australian Capital Territory"
            ],
            "range": [
              "#0072B2",
              "#A9794F",
              "#6b4fa0",
              "#CC79A7",
              "#E69F00",
              "#56B4E9",
              "#8a8478",
              "#5b574e"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "n",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "place",
            "title": "Place"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "n",
            "title": "Titles in print"
          },
          {
            "field": "arts",
            "title": "Articles in Trove",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/titles.csv"
      },
      "transform": [
        {
          "filter": "datum.lat != null && datum.lat !== '' && datum.start <= yr1 && datum.end >= yr0"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "place",
            "lat",
            "lon"
          ]
        },
        {
          "filter": "datum.n >= 14"
        }
      ],
      "mark": {
        "type": "text",
        "dy": {
          "expr": "datum.place == 'Perth' ? -50 : -26"
        },
        "fontSize": 11,
        "fontStyle": "italic",
        "fill": "#2b2620",
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "place"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}