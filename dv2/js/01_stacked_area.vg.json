{
  "title": {
    "text": [
      "From a trickle in the 1830s to",
      "millions of articles a year by 1900"
    ],
    "subtitle": [
      "Articles preserved in Trove each year, by state.",
      "Height of each band = number of articles."
    ]
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/articles_by_year_state.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d",
            "tickCount": 10,
            "grid": false
          },
          "scale": {
            "domain": [
              1810,
              1959
            ],
            "nice": false
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "total",
          "type": "quantitative",
          "stack": "zero",
          "scale": {
            "domain": [
              0,
              5500000
            ]
          },
          "axis": {
            "title": "Articles per year",
            "grid": true,
            "values": [
              0,
              1000000,
              2000000,
              3000000,
              4000000,
              5000000
            ],
            "labelExpr": "datum.value == 0 ? '0' : (datum.value / 1000000) + ' million'"
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "South Australia",
              "Western Australia",
              "Tasmania",
              "Northern Territory and Australian Capital Territory"
            ],
            "range": [
              "#0072B2",
              "#A9794F",
              "#6b4fa0",
              "#CC79A7",
              "#E69F00",
              "#56B4E9",
              "#8a8478"
            ]
          },
          "legend": {
            "orient": "top",
            "columns": {
              "expr": "width < 520 ? 1 : 3"
            },
            "title": null,
            "labelLimit": 360,
            "columnPadding": 16
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "total",
            "title": "Articles",
            "format": ","
          }
        ]
      }
    },
