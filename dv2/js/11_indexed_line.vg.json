{
  "title": {
    "text": [
      "By 1943, preserved articles fell",
      "to just over half their 1929 level"
    ],
    "subtitle": [
      "Each line shows a state's yearly total",
      "compared with its own 1929 total (1929 = 100)"
    ]
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/articles_index_1929.csv"
  },
  "transform": [
    {
      "calculate": "datum.state == 'Australia' ? 1 : 0",
      "as": "is_au"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "values": [
          1929,
          1934,
          1939,
          1944,
          1949,
          1954
        ],
        "grid": false
      },
      "scale": {
        "domain": [
          1929,
          1954
        ],
        "nice": false
      }
    },
    "y": {
      "field": "index",
      "type": "quantitative",
      "title": "Index (1929 = 100)",
      "scale": {
        "domain": [
          22,
          115
        ]
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania"
        ],
        "range": [
          "#2b2620",
          "#0072B2",
          "#D55E00",
          "#6b4fa0",
          "#CC79A7",
          "#E69F00",
          "#56B4E9"
        ]
      },
      "legend": {
        "orient": "top",
        "columns": {
          "expr": "width < 520 ? 2 : 4"
        }
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "y": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          5,
          4
        ],
        "color": "#6f665a"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone"
      },
      "encoding": {
        "strokeWidth": {
          "condition": {
            "test": "datum.is_au == 1",
            "value": 4.5
          },
          "value": 1.8
        },
        "opacity": {
          "condition": {
            "test": "datum.is_au == 1",
            "value": 1
          },
          "value": 0.7
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "size": 18,
        "filled": true,
        "opacity": 0
      },
      "encoding": {
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "index",
            "title": "Index (1929 = 100)"
          },
          {
            "field": "total",
            "title": "Articles",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 0.9
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x', 1931)"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y', 88.5) + 6"
          }
        },
        "x2": {
          "value": {
            "expr": "max(84.0, min(width - 84.0, scale('x', 1932.8)))"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y', 50) - 12.0"
          }
        },
        "color": {
          "value": "#6f665a"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "rect",
        "strokeWidth": 1,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "max(84.0, min(width - 84.0, scale('x', 1932.8))) - 82.0"
          }
        },
        "x2": {
          "value": {
            "expr": "max(84.0, min(width - 84.0, scale('x', 1932.8))) + 82.0"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y', 50) - 12.0"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y', 50) + 12.0"
          }
        },
        "color": null,
        "fill": {
          "value": "#fbf7ee"
        },
        "stroke": {
          "value": "#8f866f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "max(84.0, min(width - 84.0, scale('x', 1932.8)))"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y', 50)"
          }
        },
        "text": {
          "value": "1931: Depression, 88.5"
        },
        "color": {
          "value": "#2b2620"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 0.9
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x', 1943)"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y', 54.4) + 6"
          }
        },
        "x2": {
          "value": {
            "expr": "max(66.0, min(width - 66.0, scale('x', 1943)))"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y', 28) - 12.0"
          }
        },
        "color": {
          "value": "#6f665a"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "rect",
        "strokeWidth": 1,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "max(66.0, min(width - 66.0, scale('x', 1943))) - 64.0"
          }
        },
        "x2": {
          "value": {
            "expr": "max(66.0, min(width - 66.0, scale('x', 1943))) + 64.0"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y', 28) - 12.0"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y', 28) + 12.0"
          }
        },
        "color": null,
        "fill": {
          "value": "#fbf7ee"
        },
        "stroke": {
          "value": "#8f866f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "max(66.0, min(width - 66.0, scale('x', 1943)))"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y', 28)"
          }
        },
        "text": {
          "value": "1943: Wartime low"
        },
        "color": {
          "value": "#2b2620"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1943,
            "index": 54.4
          },
          {
            "year": 1931,
            "index": 88.5
          }
        ]
      },
      "mark": {
        "type": "point",
        "size": 90,
        "filled": false,
        "color": "#2b2620",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "index",
          "type": "quantitative"
        },
        "color": {
          "value": "#2b2620"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
