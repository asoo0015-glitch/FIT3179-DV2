{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Articles preserved in Trove, by state, per year",
    "subtitle": "Thickness of each band = number of articles"
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/articles_by_year_state.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "opacity": 0.92
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "tickCount": 10,
            "grid": false
          },
          "scale": {
            "domain": [
              1810,
              1954
            ],
            "nice": false
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "total",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "Queensland",
              "South Australia",
              "Western Australia",
              "Tasmania",
              "NT and ACT"
            ],
            "range": [
              "#0072B2",
              "#D55E00",
              "#6b4fa0",
              "#CC79A7",
              "#E69F00",
              "#56B4E9",
              "#8a8478"
            ]
          },
          "legend": {
            "orient": "top",
            "columns": 4,
            "title": null,
            "labelLimit": 260,
            "labelExpr": "datum.label == 'NT and ACT' ? 'Northern Territory and Canberra' : datum.label"
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "total",
            "title": "Articles",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1851,
            "label": "Gold rushes begin",
            "row": 6
          },
          {
            "year": 1901,
            "label": "Federation",
            "row": 6
          },
          {
            "year": 1914,
            "label": "War begins",
            "row": 6
          },
          {
            "year": 1939,
            "label": "War begins",
            "row": 6
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#2b2620",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1851,
            "label": "Gold rushes begin",
            "row": 6
          },
          {
            "year": 1914,
            "label": "War begins",
            "row": 6
          },
          {
            "year": 1939,
            "label": "War begins",
            "row": 6
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "y": 8,
        "baseline": "top",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1901,
            "label": "Federation",
            "row": 6
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "y": 8,
        "baseline": "top",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4, Georgia, serif",
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 16,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Source Serif 4, Georgia, serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 12.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e2dac6",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Source Serif 4, Georgia, serif"
    }
  }
}