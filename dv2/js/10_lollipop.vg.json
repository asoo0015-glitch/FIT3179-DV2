{
  "title": {
    "text": "The towns that printed the most newspapers"
  },
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/top_towns.csv"
  },
  "encoding": {
    "y": {
      "field": "town",
      "type": "nominal",
      "sort": [
        "Sydney, NSW",
        "Perth, WA",
        "Melbourne, VIC",
        "Hobart, TAS",
        "Adelaide, SA",
        "Fremantle, WA",
        "Brisbane, QLD",
        "Launceston, TAS",
        "Geraldton, WA",
        "Coolgardie, WA",
        "Kalgoorlie, WA",
        "Port Adelaide, SA",
        "Queanbeyan, NSW",
        "Bunbury, WA",
        "Goulburn, NSW"
      ],
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontSize": 12.5,
        "labelLimit": 230,
        "labelExpr": "split(datum.label, ', ')[0] + ', ' + ({'NSW': 'New South Wales', 'VIC': 'Victoria', 'QLD': 'Queensland', 'SA': 'South Australia', 'WA': 'Western Australia', 'TAS': 'Tasmania', 'NT': 'Northern Territory', 'ACT': 'Australian Capital Territory'})[split(datum.label, ', ')[1]]"
      }
    },
    "x": {
      "field": "titles",
      "type": "quantitative",
      "title": "Number of titles",
      "axis": {
        "grid": true,
        "tickMinStep": 25
      }
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ],
        "range": [
          "#0072B2",
          "#D55E00",
          "#6b4fa0",
          "#CC79A7",
          "#E69F00",
          "#56B4E9",
          "#8a8478",
          "#5b574e"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 190,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "town",
            "title": "Town"
          },
          {
            "field": "titles",
            "title": "Titles"
          },
          {
            "field": "articles",
            "title": "Articles in Trove",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "color": "#2b2620"
      },
      "encoding": {
        "text": {
          "field": "titles"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4, Georgia, serif",
    "title": {
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 16,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Source Serif 4, Georgia, serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 12.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#e2dac6",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Source Serif 4, Georgia, serif"
    }
  }
}