{
  "title": {
    "text": "Newspaper titles launched and closed, by decade",
    "subtitle": [
      "Each bar counts titles that started (left)",
      "or stopped (right) in that decade."
    ]
  },
  "width": "container",
  "height": 560,
  "encoding": {
    "y": {
      "field": "label",
      "type": "ordinal",
      "title": "Decade",
      "sort": [
        "1830s",
        "1840s",
        "1850s",
        "1860s",
        "1870s",
        "1880s",
        "1890s",
        "1900s",
        "1910s",
        "1920s",
        "1930s",
        "1940s"
      ],
      "axis": {
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/butterfly_long.csv"
      },
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": "\u2190 Titles launched        Titles closed \u2192",
          "scale": {
            "domain": [
              -385,
              385
            ],
            "nice": false
          },
          "axis": {
            "values": [
              -300,
              -200,
              -100,
              0,
              100,
              200,
              300
            ],
            "labelExpr": "abs(datum.value)"
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Titles launched",
              "Titles closed",
              "Victorian papers in Trove only for 1914\u20131918"
            ],
            "range": [
              "#21736d",
              "#5b574e",
              "#c4baa4"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "columns": 1,
            "labelLimit": 380
          }
        },
        "order": {
          "field": "stack_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Decade"
          },
          {
            "field": "series",
            "title": "Group"
          },
          {
            "field": "value",
            "title": "Titles (negative = launched)"
          },
          {
            "field": "net",
            "title": "Net change in decade"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/titles_launched_closed_by_decade.csv"
      },
      "transform": [
        {
          "calculate": "-datum.Launched",
          "as": "neg"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "fontSize": 11,
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "neg",
          "type": "quantitative"
        },
        "text": {
          "field": "Launched"
        }
      }
    },
    {
      "data": {
        "url": "data/titles_launched_closed_by_decade.csv"
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "Closed",
          "type": "quantitative"
        },
        "text": {
          "field": "Closed"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "1860s",
            "x0": 115,
            "x1": 375
          }
        ]
      },
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.8
        },
        "fill": "#fffdf7",
        "stroke": "#8f866f",
        "strokeWidth": 1,
        "cornerRadius": 3,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "x2": {
          "field": "x1"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "1860s",
            "x": 115
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2b2620",
        "lineHeight": 13,
        "dy": -6.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Gold rushes, railways: most",
            "launches of any decade"
          ]
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "1870s",
            "x0": 115,
            "x1": 375
          }
        ]
      },
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.8
        },
        "fill": "#fffdf7",
        "stroke": "#8f866f",
        "strokeWidth": 1,
        "cornerRadius": 3,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "x2": {
          "field": "x1"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "1870s",
            "x": 115
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2b2620",
        "lineHeight": 13,
        "dy": -6.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Grey bars below: slices,",
            "not new launches or closures"
          ]
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "1940s",
            "x0": -372,
            "x1": -112
          }
        ]
      },
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.8
        },
        "fill": "#fffdf7",
        "stroke": "#8f866f",
        "strokeWidth": 1,
        "cornerRadius": 3,
        "tooltip": null
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "x2": {
          "field": "x1"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "1940s",
            "x": -372
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2b2620",
        "lineHeight": 13,
        "dy": -6.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Depression and war years:",
            "new launches more than halve"
          ]
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}