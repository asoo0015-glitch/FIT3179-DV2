{
  "title": {
    "text": "Newspaper titles launched and closed, by decade",
    "subtitle": [
      "The 1890s had the most launches (247).",
      "From the 1920s, more titles closed than opened."
    ]
  },
  "width": "container",
  "height": 340,
  "encoding": {
    "y": {
      "field": "label",
      "type": "ordinal",
      "title": "Decade",
      "sort": [
        "1830s",
        "1840s",
        "1850s",
        "1860s",
        "1870s",
        "1880s",
        "1890s",
        "1900s",
        "1910s",
        "1920s",
        "1930s",
        "1940s"
      ],
      "axis": {
        "labelFontSize": 12,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/butterfly_long.csv"
      },
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": "\u2190 Titles launched        Titles closed \u2192",
          "axis": {
            "values": [
              -300,
              -200,
              -100,
              0,
              100,
              200,
              300
            ],
            "labelExpr": "abs(datum.value)"
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Titles launched",
              "Titles closed",
              "Victorian papers in Trove only for 1914\u20131918"
            ],
            "range": [
              "#21736d",
              "#5b574e",
              "#c4baa4"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "columns": 1,
            "labelLimit": 380
          }
        },
        "order": {
          "field": "stack_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Decade"
          },
          {
            "field": "series",
            "title": "Group"
          },
          {
            "field": "value",
            "title": "Titles (negative = launched)"
          },
          {
            "field": "net",
            "title": "Net change in decade"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/titles_launched_closed_by_decade.csv"
      },
      "transform": [
        {
          "calculate": "-datum.Launched",
          "as": "neg"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "fontSize": 11,
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "neg",
          "type": "quantitative"
        },
        "text": {
          "field": "Launched"
        }
      }
    },
    {
      "data": {
        "url": "data/titles_launched_closed_by_decade.csv"
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "Closed",
          "type": "quantitative"
        },
        "text": {
          "field": "Closed"
        }
      }
    },
    {
      "data": {
        "url": "data/titles_launched_closed_by_decade.csv"
      },
      "transform": [
        {
          "calculate": "'Net ' + (datum.net > 0 ? '+' : '\u2212') + abs(datum.net)",
          "as": "netlabel"
        },
        {
          "calculate": "340",
          "as": "netx"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "netx",
          "type": "quantitative"
        },
        "text": {
          "field": "netlabel"
        },
        "color": {
          "condition": {
            "test": "datum.net < 0",
            "value": "#5b574e"
          },
          "value": "#21736d"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}