{
  "title": {
    "text": [
      "What filled the pages:",
      "100 squares = all 251 million articles"
    ],
    "subtitle": [
      "Each square = 1% of the articles,",
      "about 2.5 million"
    ]
  },
  "width": 430,
  "height": 430,
  "data": {
    "url": "data/waffle_cells.csv"
  },
  "transform": [
    {
      "calculate": "split(datum.category, ' (')[0]",
      "as": "type_name"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#fbf7ee",
    "strokeWidth": 2.5,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Type of article",
      "scale": {
        "domain": [
          "News and other articles (69%)",
          "Advertising (19%)",
          "Lists, results and guides (11%)",
          "Family notices (1%)"
        ],
        "range": [
          "#a39574",
          "#d6ccb0",
          "#5b574e",
          "#21736d"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "vertical",
        "symbolSize": 160,
        "labelLimit": 340,
        "labelFontSize": 11,
        "labelExpr": "split(datum.label, ' (')[0]"
      }
    },
    "tooltip": [
      {
        "field": "type_name",
        "title": "Type"
      },
      {
        "field": "share_pct",
        "title": "Exact share (%)"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}