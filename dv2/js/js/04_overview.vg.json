{
  "title": {
    "text": [
      "Drag across the chart to choose",
      "the years shown on the maps below"
    ],
    "fontSize": 12.5,
    "font": "Verdana, Geneva, sans-serif",
    "fontStyle": "italic",
    "fontWeight": 400
  },
  "width": "container",
  "height": 130,
  "data": {
    "url": "data/active_titles_by_year_state.csv"
  },
  "params": [
    {
      "name": "brush",
      "value": {
        "year": [
          1850,
          1900
        ]
      },
      "select": {
        "type": "interval",
        "encodings": [
          "x"
        ]
      }
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d",
        "tickCount": 15,
        "grid": false
      },
      "scale": {
        "domain": [
          1803,
          1954
        ],
        "nice": false
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "titles",
      "type": "quantitative",
      "title": "Titles in print",
      "axis": {
        "tickCount": 3
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "NT and ACT",
          "Victorian papers in Trove only for 1914\u20131918"
        ],
        "range": [
          "#0072B2",
          "#D55E00",
          "#6b4fa0",
          "#CC79A7",
          "#E69F00",
          "#56B4E9",
          "#8a8478",
          "#c4baa4"
        ]
      },
      "legend": {
        "orient": "top",
        "columns": {
          "expr": "width < 480 ? 1 : width < 760 ? 3 : 4"
        },
        "labelLimit": 360,
        "labelExpr": "datum.label == 'NT and ACT' ? 'Northern Territory and Canberra' : datum.label"
      }
    },
    "order": {
      "field": "group",
      "sort": "descending"
    },
    "tooltip": [
      {
        "field": "group",
        "title": "State"
      },
      {
        "field": "year",
        "format": "d",
        "title": "Year"
      },
      {
        "field": "titles",
        "title": "Titles in print"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}