{
  "title": {
    "text": "The 15 longest-running newspapers in Trove",
    "subtitle": [
      "Bars show each title's run in Trove;",
      "the number is its length in years"
    ]
  },
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/longest_running_titles.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.6
        },
        "cornerRadius": 2
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "title": "Newspaper",
          "sort": [
            "The Riverine Herald",
            "Le Courrier Australien",
            "The Sydney Morning Herald",
            "The Argus",
            "The Age",
            "Ovens and Murray Advertiser",
            "Williamstown Chronicle",
            "The Armidale Express and New Engl\u2026",
            "Illawarra Mercury",
            "The Mercury",
            "Gippsland Times",
            "Border Watch",
            "The Herald",
            "Bunyip",
            "Southern Argus"
          ],
          "axis": {
            "labelLimit": 250,
            "ticks": false,
            "domain": false,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [
              1835,
              2035
            ],
            "nice": false
          },
          "axis": {
            "format": "d",
            "values": [
              1840,
              1860,
              1880,
              1900,
              1920,
              1940,
              1960,
              1980,
              2000,
              2020
            ]
          }
        },
        "x2": {
          "field": "end"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "New South Wales",
              "Victoria",
              "South Australia",
              "Tasmania"
            ],
            "range": [
              "#0072B2",
              "#D55E00",
              "#CC79A7",
              "#56B4E9"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "columns": {
              "expr": "width < 200 ? 1 : width < 340 ? 2 : 4"
            },
            "labelLimit": 200
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Newspaper"
          },
          {
            "field": "place",
            "title": "Place"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "start",
            "title": "First year",
            "format": "d"
          },
          {
            "field": "end",
            "title": "Last year",
            "format": "d"
          },
          {
            "field": "years",
            "title": "Years in Trove"
          },
          {
            "field": "articles",
            "title": "Articles in Trove",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11,
        "color": "#2b2620"
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "title": "Newspaper",
          "sort": [
            "The Riverine Herald",
            "Le Courrier Australien",
            "The Sydney Morning Herald",
            "The Argus",
            "The Age",
            "Ovens and Murray Advertiser",
            "Williamstown Chronicle",
            "The Armidale Express and New Engl\u2026",
            "Illawarra Mercury",
            "The Mercury",
            "Gippsland Times",
            "Border Watch",
            "The Herald",
            "Bunyip",
            "Southern Argus"
          ],
          "axis": {
            "labelLimit": 250,
            "ticks": false,
            "domain": false,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "years",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1954
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1980
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "baseline": "top",
        "fontStyle": "italic",
        "fontSize": 11,
        "y": {
          "expr": "height - 58"
        },
        "color": "#2b2620"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "1954: Most of",
            "Trove stops here"
          ]
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}