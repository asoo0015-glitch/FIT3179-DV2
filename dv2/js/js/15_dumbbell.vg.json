{
  "title": {
    "text": [
      "Western Australia's titles more than",
      "doubled while Victoria's fell"
    ],
    "subtitle": "Titles in print by state, 1900 against 1930"
  },
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/active_titles_by_year_state.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "titles": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "(datum.year == 1900 || datum.year == 1930) && indexof(datum.group, 'Victorian papers') < 0"
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "title": "State",
      "sort": [
        "Western Australia",
        "Queensland",
        "South Australia",
        "New South Wales",
        "Tasmania",
        "Victoria",
        "NT and ACT"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 150
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#8f866f",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "titles",
          "type": "quantitative",
          "aggregate": "min",
          "title": "Titles in print"
        },
        "x2": {
          "field": "titles",
          "aggregate": "max"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 190,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "titles",
          "type": "quantitative"
        },
        "color": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "scale": {
            "domain": [
              1900,
              1930
            ],
            "range": [
              "#8f866f",
              "#21736d"
            ]
          },
          "legend": {
            "orient": "top",
            "format": "d"
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "titles",
            "title": "Titles in print"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}