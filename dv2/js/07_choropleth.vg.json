{
  "title": {
    "text": "Titles in print, by state"
  },
  "width": "container",
  "height": 330,
  "params": [
    {
      "name": "yr0",
      "value": 1850
    },
    {
      "name": "yr1",
      "value": 1900
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "'No data: ' + datum.properties.STE_NAME21",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "title": "State"
        },
        "fill": {
          "datum": "No data",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "No data"
            ],
            "range": [
              "#d3d3d3"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "symbolType": "square",
            "symbolSize": 110,
            "symbolStrokeColor": "#b9ae96",
            "symbolStrokeWidth": 0.6,
            "offset": 6
          }
        }
      }
    },
    {
      "data": {
        "url": "data/titles.csv"
      },
      "transform": [
        {
          "filter": "datum.state != 'International' && datum.state != 'National' && datum.start <= yr1 && datum.end >= yr0"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state_area.csv"
            },
            "key": "state",
            "fields": [
              "area_km2"
            ]
          }
        },
        {
          "calculate": "datum.n / datum.area_km2 * 100000",
          "as": "per100k"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.STE_NAME21"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "per100k",
          "type": "quantitative",
          "title": "Titles per 100,000 km\u00b2",
          "scale": {
            "type": "sqrt",
            "range": [
              "#e3f1ee",
              "#8cc4bb",
              "#4aa093"
            ],
            "domainMin": 0
          },
          "legend": {
            "orient": "bottom-left",
            "format": "~s",
            "gradientLength": 120
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "n",
            "title": "Titles in print"
          },
          {
            "field": "per100k",
            "title": "Per 100,000 km\u00b2",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "s": [
              "New South",
              "Wales"
            ],
            "lon": 146.5,
            "lat": -32.3
          },
          {
            "s": "Victoria",
            "lon": 144.8,
            "lat": -36.9
          },
          {
            "s": "Queensland",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "s": [
              "South",
              "Australia"
            ],
            "lon": 135.0,
            "lat": -30.0
          },
          {
            "s": [
              "Western",
              "Australia"
            ],
            "lon": 122.0,
            "lat": -25.5
          },
          {
            "s": "Tasmania",
            "lon": 146.6,
            "lat": -42.1
          },
          {
            "s": [
              "Northern",
              "Territory"
            ],
            "lon": 133.5,
            "lat": -19.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#2b2620",
        "opacity": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "s"
        }
      }
    },
    {
      "data": {
        "url": "data/titles.csv"
      },
      "transform": [
        {
          "filter": "datum.state != 'International' && datum.state != 'National' && datum.start <= yr1 && datum.end >= yr0"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/state_area.csv"
            },
            "key": "state",
            "fields": [
              "area_km2"
            ]
          }
        },
        {
          "calculate": "datum.n / datum.area_km2 * 100000",
          "as": "per100k"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "rk"
            }
          ],
          "sort": [
            {
              "field": "per100k",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rk == 1"
        },
        {
          "calculate": "'Most titles for its size: ' + datum.state",
          "as": "top"
        }
      ],
      "mark": {
        "type": "text",
        "x": 0,
        "y": 0,
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2b2620"
      },
      "encoding": {
        "text": {
          "field": "top"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Verdana, Geneva, sans-serif",
    "title": {
      "font": "Merriweather, Georgia, serif",
      "fontSize": 15,
      "color": "#2b2620",
      "anchor": "start",
      "fontWeight": 700,
      "subtitleFont": "Verdana, Geneva, sans-serif",
      "subtitleFontWeight": 400,
      "subtitleColor": "#6f665a",
      "subtitleFontSize": 11.5,
      "subtitlePadding": 6,
      "offset": 10
    },
    "axis": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#6f665a",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "gridColor": "#e8e0cd",
      "domainColor": "#b9ae96",
      "tickColor": "#b9ae96"
    },
    "legend": {
      "labelFont": "Verdana, Geneva, sans-serif",
      "titleFont": "Verdana, Geneva, sans-serif",
      "labelColor": "#2b2620",
      "titleColor": "#6f665a",
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 400,
      "symbolType": "square",
      "symbolOpacity": 1
    },
    "text": {
      "font": "Verdana, Geneva, sans-serif"
    }
  }
}