{
  "title": {
    "text": "Where newspapers first appeared",
    "subtitle": [
      "One dot per title, grouped",
      "by the era it started in"
    ]
  },
  "hconcat": [
    {
      "title": {
        "text": "Before 1860",
        "font": "Merriweather, Georgia, serif",
        "fontSize": 14,
        "anchor": "middle"
      },
      "width": 320,
      "height": 300,
      "projection": {
        "type": "mercator",
        "center": [
          133.5,
          -27.5
        ],
        "scale": 430,
        "translate": [
          160,
          150
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e4dcc8",
            "stroke": "white",
            "strokeWidth": 0.8
          }
        },
        {
          "data": {
            "url": "data/titles.csv"
          },
          "transform": [
            {
              "filter": "datum.lat != null && datum.era == '1. Before 1860'"
            }
          ],
          "mark": {
            "type": "circle",
            "opacity": 0.6,
            "size": 22
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "color": {
              "field": "place_type",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Capital city",
                  "Regional town"
                ],
                "range": [
                  "#1d1a16",
                  "#21736d"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "short",
                "title": "Title"
              },
              {
                "field": "place",
                "title": "Place"
              },
              {
                "field": "start",
                "title": "Started",
                "format": "d"
              }
            ]
          }
        }
      ]
    },
